<Window x:Class="CatFeeder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление кормушкой для кота"
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14">

    <DockPanel>
        <!-- STATUS BAR -->
        <StatusBar DockPanel.Dock="Bottom" Background="#1E1E1E" Foreground="White">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" FontFamily="Consolas" FontSize="13" Text="..."/>
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="5">

            <!-- ================== КОРМУШКИ ================== -->
            <TabItem Header="Кормушки">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="FeedersGrid"
                              Grid.Column="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              FontSize="13">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Foreground" Value="OrangeRed"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="140"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding TypeName}" Width="100"/>
                            <DataGridTextColumn Header="Корм (бак)" Binding="{Binding FoodText}" Width="120"/>
                            <DataGridTextColumn Header="В миске" Binding="{Binding BowlText}" Width="90"/>
                            <DataGridTextColumn Header="Вода" Binding="{Binding WaterText}" Width="90"/>
                            <DataGridTextColumn Header="Расписание" Binding="{Binding ScheduleName}" Width="130"/>
                            <DataGridTextColumn Header="Метки" Binding="{Binding LabelsText}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                  Margin="8,0,0,0" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Button Content="+ Дозатор"        Click="AddDispenser_Click"    Margin="0,2" Padding="5"/>
                            <Button Content="+ По весу"        Click="AddWeightSensor_Click"  Margin="0,2" Padding="5"/>
                            <Button Content="Удалить"          Click="RemoveFeeder_Click"     Margin="0,2" Padding="5"/>
                            <Separator Margin="0,6"/>
                            <Button Content="Добавить корм"    Click="RefillFood_Click"       Margin="0,2" Padding="5"/>
                            <Button Content="Добавить воду"    Click="RefillWater_Click"      Margin="0,2" Padding="5"/>
                            <Button Content="Покормить"        Click="FeedNow_Click"          Margin="0,2" Padding="5"/>
                            <Separator Margin="0,6"/>
                            <Button Content="Посмотреть лог"   Click="ViewLog_Click"          Margin="0,2" Padding="5"/>
                            <Button Content="Экспорт лога (.txt)" Click="ExportLog_Click"       Margin="0,2" Padding="5"/>
                            <Separator Margin="0,6"/>
                            <Button Content="Отложить выдачу"  Click="PostponeNext_Click"     Margin="0,2" Padding="5"/>
                            <Button Content="Отменить выдачу"  Click="CancelNext_Click"       Margin="0,2" Padding="5"/>
                            <Button Content="Назначить расписание" Click="AssignSchedule_Click" Margin="0,2" Padding="5"/>
                            <Button Content="Изменить метки"   Click="EditLabels_Click"       Margin="0,2" Padding="5"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ================== РАСПИСАНИЯ ================== -->
            <TabItem Header="Расписания">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
                            <Button Content="+ Добавить" Click="AddSchedule_Click"    Margin="2" Padding="8,3"/>
                            <Button Content="Удалить"    Click="RemoveSchedule_Click" Margin="2" Padding="8,3"/>
                            <Button Content="Экспорт"    Click="ExportSchedule_Click" Margin="2" Padding="8,3"/>
                            <Button Content="Импорт"     Click="ImportSchedule_Click" Margin="2" Padding="8,3"/>
                        </StackPanel>
                        <ListBox x:Name="SchedulesList"
                                 DisplayMemberPath="Name"
                                 FontSize="14"
                                 SelectionChanged="SchedulesList_SelectionChanged"/>
                    </DockPanel>

                    <DockPanel Grid.Column="1" Margin="8,0,0,0">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
                            <Button Content="+ Кормление" Click="AddFeeding_Click"    Margin="2" Padding="8,3"/>
                            <Button Content="- Кормление" Click="RemoveFeeding_Click" Margin="2" Padding="8,3"/>
                        </StackPanel>
                        <DataGrid x:Name="FeedingsGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  CanUserAddRows="False"
                                  FontSize="13">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Время" Binding="{Binding TimeText}" Width="130"/>
                                <DataGridTextColumn Header="Количество" Binding="{Binding AmountText}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ================== КОТЫ И СИМУЛЯЦИЯ (ОБЪЕДИНЕННАЯ) ================== -->
            <TabItem Header="Коты и Симуляция">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Управление симуляцией -->
                        <RowDefinition Height="2*"/>
                        <!-- Таблица котов -->
                        <RowDefinition Height="1*"/>
                        <!-- Лог -->
                    </Grid.RowDefinitions>

                    <!-- Верхняя панель: Симуляция -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="SimStatusText" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock x:Name="CatStatusText" FontFamily="Consolas" FontSize="13" Margin="0,0,0,5"/>

                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Button Content="▶ Старт" Click="SimStart_Click" Padding="12,5" Margin="0,0,5,0"/>
                            <Button Content="⏸ Пауза" Click="SimPause_Click" Padding="12,5" Margin="0,0,5,0"/>
                            <Button Content="Множитель времени" Click="SimSetMultiplier_Click" Padding="12,5"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Средняя панель: Таблица котов -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="250"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid x:Name="CatsGrid" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" FontSize="13">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="150"/>
                                <DataGridTextColumn Header="Голод" Binding="{Binding HungerText}" Width="100"/>
                                <DataGridTextColumn Header="Порог еды" Binding="{Binding ThresholdText}" Width="100"/>
                                <DataGridTextColumn Header="Вода (мл/г)" Binding="{Binding WaterRateText}" Width="120"/>
                                <DataGridTextColumn Header="Привязан к кормушке" Binding="{Binding FeederName}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <Button Content="+ Добавить кота" Click="AddCat_Click" Margin="0,2"/>
                            <Button Content="Удалить кота" Click="RemoveCat_Click" Margin="0,2"/>
                            <Separator Margin="0,6"/>
                            <Button Content="Изменить голод" Click="EditCatHunger_Click" Margin="0,2"/>
                            <Button Content="Изменить порог еды" Click="EditCatThreshold_Click" Margin="0,2"/>
                            <Button Content="Расход воды (мл/г)" Click="EditCatWaterRate_Click" Margin="0,2"/>
                            <Button Content="Назначить кормушку" Click="AssignCatFeeder_Click" Margin="0,2"/>
                        </StackPanel>
                    </Grid>

                    <!-- Нижняя панель: Лог -->
                    <GroupBox Grid.Row="2" Header="Лог активности питомцев и событий" Margin="0,10,0,0" FontSize="13">
                        <ListBox x:Name="CatLogList" FontFamily="Consolas" FontSize="12"/>
                    </GroupBox>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>